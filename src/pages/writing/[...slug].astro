---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    {post.data.hero && (
      <Image
        src={post.data.hero}
        alt=""
        widths={[620, 1240]}
        sizes="(min-width: 680px) 620px, 100vw"
        loading="eager"
        class="mb-8 h-auto w-full rounded-[12px]"
      />
    )}
    <p class="mb-3 text-[15px] text-muted tabular-nums">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.draft && <span class="ml-2">Draft</span>}
    </p>
    <h1 class="mb-8 text-[40px] leading-[1.12] font-semibold tracking-[-0.028em] text-balance">{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
