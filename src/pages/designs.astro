---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Preview from '../components/Preview.astro';
import Base from '../layouts/Base.astro';

interface Design {
  slug: string;
  caption: string;
  thumb: string;
  full: string;
  width: number;
  height: number;
}

interface Section {
  slug: string;
  title: string;
  items: Design[];
}

// Written by scripts/build-designs.mjs before every `dev` and `build`.
let sections: Section[] = [];
try {
  sections = JSON.parse(await readFile(join(process.cwd(), 'public/designs/manifest.json'), 'utf8'));
} catch {}

// Every design covers the same area as a SIDE × SIDE square, whatever its shape,
// and sits on the shelf's bottom line so the captions line up. Sizes are in
// shelf units (--u): one CSS pixel, or less on a screen too narrow for a square.
const SIDE = 360;
const shelves = sections.map((section) => {
  const items = section.items.map((design) => {
    const ratio = design.width / design.height;
    return { ...design, w: SIDE * Math.sqrt(ratio), h: SIDE / Math.sqrt(ratio) };
  });
  return { ...section, items, band: Math.max(...items.map((item) => item.h)) };
});
---
<Base title="Designs" wide>
  <h1 class="mb-8 text-[40px] leading-[1.12] font-semibold tracking-[-0.028em]">Designs</h1>
  <hr class="mb-10 h-px border-0 bg-hairline" />

  {shelves.length === 0 ? (
    <p class="text-muted">No designs yet.</p>
  ) : (
    <div class="flex flex-col gap-16">
      {shelves.map((section, s) => (
        <section class="design-section" aria-labelledby={`${section.slug}-title`}>
          <h2 id={`${section.slug}-title`} class="mb-3 text-[26px] leading-[1.25] font-semibold tracking-[-0.02em]">
            {section.title}
          </h2>

          <div class="shelf-wrap" style={`--band: ${section.band.toFixed(2)}`} data-shelf>
            <ul id={`${section.slug}-shelf`} class="shelf" aria-labelledby={`${section.slug}-title`}>
              {section.items.map((design, i) => (
                <li class="item" style={`--w: ${design.w.toFixed(2)}; --h: ${design.h.toFixed(2)}`}>
                  <div class="frame">
                    <button
                      type="button"
                      class="design"
                      data-preview
                      data-native="css"
                      data-radius="32"
                      data-full={design.full}
                      data-thumb={design.thumb}
                      data-alt={design.caption}
                      data-width={design.width}
                      data-height={design.height}
                      aria-label={`View larger: ${design.caption}`}
                    >
                      <img
                        src={design.thumb}
                        alt={design.caption}
                        width={design.width}
                        height={design.height}
                        loading={s === 0 && i < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </button>
                  </div>
                  <p class="caption">{design.caption}</p>
                </li>
              ))}
            </ul>

            {/* Enabled by the script below once it knows there's more to see. */}
            <button
              type="button"
              class="arrow arrow-prev"
              aria-label={`Scroll ${section.title} left`}
              aria-controls={`${section.slug}-shelf`}
              data-dir="-1"
              disabled
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4L6 9l5 5"></path></svg>
            </button>
            <button
              type="button"
              class="arrow arrow-next"
              aria-label={`Scroll ${section.title} right`}
              aria-controls={`${section.slug}-shelf`}
              data-dir="1"
              disabled
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4l5 5-5 5"></path></svg>
            </button>
          </div>
        </section>
      ))}
    </div>
  )}

  <Preview />
</Base>

<style>
  /* Registered so the edge fades can transition. */
  @property --fade-start {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @property --fade-end {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .design-section {
    container-type: inline-size;
  }

  .shelf-wrap {
    /* One shelf unit: a CSS pixel, scaled down on screens narrower than 400px. */
    --u: min(1px, 100cqi / 400);
    /* Room around the designs for the hover scale, inside the scroll area. */
    --pad: 12px;
    position: relative;
  }

  .shelf {
    --fade: 64px;
    position: relative;
    display: flex;
    gap: calc(36 * var(--u));
    margin-inline: calc(-1 * var(--pad));
    padding: 20px var(--pad);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--pad);
    scrollbar-width: none;
    /* Designs fade out under the arrows, on the sides with more to see. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent
    );
    transition:
      --fade-start 240ms ease,
      --fade-end 240ms ease;
  }

  .shelf::-webkit-scrollbar {
    display: none;
  }

  .shelf-wrap[data-before] .shelf {
    --fade-start: var(--fade);
  }

  .shelf-wrap[data-after] .shelf {
    --fade-end: var(--fade);
  }

  .item {
    flex: none;
    width: calc(var(--w) * var(--u));
    scroll-snap-align: start;
  }

  .frame {
    display: flex;
    align-items: flex-end;
    height: calc(var(--band) * var(--u));
  }

  /* Shown uncropped, with no background or grain, since most are transparent. */
  .design {
    display: block;
    width: 100%;
    height: calc(var(--h) * var(--u));
    cursor: zoom-in;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .design img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: calc(32 * var(--u));
  }

  .caption {
    margin-top: 16px;
    text-align: center;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-muted);
  }

  /*
    The arrows: a frosted white disc on a hairline, with the same 1.6 round
    stroke as the menu icon. Green only on interaction, like every link here.
  */
  .arrow {
    position: absolute;
    /* Centered on the designs, not the captions. */
    top: calc(20px + var(--band) * var(--u) / 2);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    color: #000000;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 6px 18px rgb(0 0 0 / 0.08);
    cursor: pointer;
    transition:
      opacity 200ms ease,
      scale 200ms cubic-bezier(0.2, 0.7, 0.2, 1),
      color 160ms ease,
      border-color 160ms ease,
      box-shadow 200ms ease,
      visibility 0s;
  }

  .arrow-prev {
    left: 0;
  }

  .arrow-next {
    right: 0;
  }

  .arrow svg {
    transition: translate 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .arrow:focus-visible {
    border-radius: 9999px;
  }

  @media (hover: hover) {
    .arrow:hover {
      color: var(--color-tint);
      border-color: color-mix(in srgb, var(--color-tint) 28%, var(--color-rule));
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.06),
        0 10px 24px rgb(0 0 0 / 0.11);
    }
    .arrow-next:hover svg {
      translate: 2px 0;
    }
    .arrow-prev:hover svg {
      translate: -2px 0;
    }
    .design:hover {
      transform: scale(1.04);
    }
  }

  .arrow:active {
    scale: 0.94;
  }

  /* At either end, the arrow on that side fades away. */
  .arrow:disabled {
    opacity: 0;
    scale: 0.86;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      scale 200ms ease,
      visibility 0s linear 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .design {
      transition: none;
    }
    .design:hover {
      transform: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((wrap) => {
    const shelf = wrap.querySelector<HTMLElement>('.shelf');
    const prev = wrap.querySelector<HTMLButtonElement>('.arrow-prev');
    const next = wrap.querySelector<HTMLButtonElement>('.arrow-next');
    if (!shelf || !prev || !next) return;
    const items = Array.from(shelf.children) as HTMLElement[];
    const pad = () => parseFloat(getComputedStyle(shelf).paddingLeft) || 0;

    function update() {
      const max = shelf!.scrollWidth - shelf!.clientWidth;
      const before = shelf!.scrollLeft > 2;
      const after = shelf!.scrollLeft < max - 2;
      // Keep keyboard focus when the focused arrow is about to disappear.
      if (document.activeElement === next && !after && before) prev!.disabled = false, prev!.focus();
      if (document.activeElement === prev && !before && after) next!.disabled = false, next!.focus();
      prev!.disabled = !before;
      next!.disabled = !after;
      wrap.toggleAttribute('data-before', before);
      wrap.toggleAttribute('data-after', after);
    }

    // Next: the first design that's cut off on the right moves to the left edge.
    // Previous: back by a full view, landing on a design's left edge.
    function target(dir: number) {
      const p = pad();
      const left = shelf!.scrollLeft;
      const view = shelf!.clientWidth - 2 * p;
      if (dir > 0) {
        const cut = items.find((item) => item.offsetLeft + item.offsetWidth > left + p + view + 1);
        const to = cut ? cut.offsetLeft - p : left + view;
        return to > left + 1 ? to : left + view;
      }
      const goal = left - view;
      const first = items.find((item) => item.offsetLeft - p >= goal - 1);
      const to = first ? first.offsetLeft - p : goal;
      return to < left - 1 ? to : goal;
    }

    for (const arrow of [prev, next]) {
      arrow.addEventListener('click', () => {
        shelf.scrollTo({
          left: target(Number(arrow.dataset.dir)),
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      });
    }

    let frame = 0;
    shelf.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    new ResizeObserver(update).observe(shelf);
    update();
  });
</script>
