---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

interface Photo {
  slug: string;
  alt: string;
  thumb: string;
  full: string;
  size: number;
}

// Written by scripts/build-photos.mjs before every `dev` and `build`.
let photos: Photo[] = [];
try {
  photos = JSON.parse(await readFile(join(process.cwd(), 'public/photos/manifest.json'), 'utf8'));
} catch {}
---
<Base title="Photos" wide>
  <h1 class="mb-8 text-[40px] leading-[1.12] font-semibold tracking-[-0.028em]">Photos</h1>

  {photos.length === 0 ? (
    <p class="text-muted">No photos yet.</p>
  ) : (
    <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3">
      {photos.map((photo, i) => (
        <li class="relative aspect-square">
          <button
            type="button"
            class="photo grain"
            data-full={photo.full}
            data-thumb={photo.thumb}
            data-alt={photo.alt}
            data-size={photo.size}
            aria-label={`View larger: ${photo.alt}`}
          >
            <img
              src={photo.thumb}
              alt={photo.alt}
              width="800"
              height="800"
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
        </li>
      ))}
    </ul>
  )}

  <dialog id="preview" class="preview" aria-label="Photo preview" tabindex="-1">
    <div class="preview-frame grain">
      <img id="preview-image" alt="" />
    </div>
  </dialog>
</Base>

<style>
  /*
    Hover scales the whole tile, photo and grain together, so the grain stays
    fixed to the photo like it's part of it. At rest there's no transform, so
    every grain pixel sits on a screen pixel.
  */
  .photo {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-wash);
    cursor: zoom-in;
    isolation: isolate;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .photo:hover {
      transform: scale(1.04);
      z-index: 1;
    }
    .photo:hover img {
      filter: saturate(1);
    }
  }

  .photo:focus-visible img {
    filter: saturate(1);
  }

  /*
    Film grain, drawn over the photo rather than baked into it, so downloads stay
    clean. The tile (scripts/build-grain.mjs) is centered on 50% gray: overlay
    leaves average brightness alone and the grain shows most in the midtones.
    It's drawn at exactly one grain pixel per screen pixel: the script below
    sets --grain-size for the display's density, including browser zoom.
  */
  .grain::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: url('/grain.webp') 0 0 / var(--grain-size, 512px) repeat;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }

  @media (resolution >= 2x) {
    :global(:root) {
      --grain-size: 256px;
    }
  }

  .preview {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
    outline: none;
  }

  .preview[open] {
    display: block;
    animation: fade-in 200ms ease-out;
  }

  .preview::backdrop {
    background: rgb(0 0 0 / 0.82);
  }

  .preview[open]::backdrop {
    animation: fade-in 220ms ease-out;
  }

  .preview.closing {
    animation: fade-out 160ms ease-in forwards;
  }

  .preview.closing::backdrop {
    animation: fade-out 160ms ease-in forwards;
  }

  /* Sized and placed on whole screen pixels by the script below, so the photo
     and its grain are never resampled. Fades only, for the same reason. */
  .preview-frame {
    position: absolute;
    overflow: hidden;
    border-radius: 4px;
    isolation: isolate;
    background: var(--thumb) center / cover no-repeat;
  }

  .preview-frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(html:has(#preview[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .photo img {
      transition: none;
    }
    .photo:hover {
      transform: none;
    }
    .preview[open],
    .preview[open]::backdrop,
    .preview.closing,
    .preview.closing::backdrop {
      animation: none;
    }
  }
</style>

<script>
  const dialog = document.getElementById('preview') as HTMLDialogElement | null;
  const image = document.getElementById('preview-image') as HTMLImageElement | null;
  const frame = dialog?.querySelector<HTMLElement>('.preview-frame');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let photoSize = 0;

  // One grain pixel per screen pixel. Re-run when the density changes (browser
  // zoom, or moving the window to another display).
  function sizeGrain() {
    const dpr = window.devicePixelRatio || 1;
    document.documentElement.style.setProperty('--grain-size', `${512 / dpr}px`);
    window.matchMedia(`(resolution: ${dpr}dppx)`).addEventListener('change', sizeGrain, { once: true });
  }
  sizeGrain();

  // Fits the preview in 92% of the window, never larger than the photo's own
  // pixels, snapped to whole screen pixels and centered on a pixel boundary.
  function layout() {
    if (!dialog || !frame) return;
    const dpr = window.devicePixelRatio || 1;
    const width = Math.round(dialog.clientWidth * dpr);
    const height = Math.round(dialog.clientHeight * dpr);
    const side = Math.floor(Math.min(width * 0.92, height * 0.92, photoSize || Infinity));
    frame.style.width = frame.style.height = `${side / dpr}px`;
    frame.style.left = `${Math.round((width - side) / 2) / dpr}px`;
    frame.style.top = `${Math.round((height - side) / 2) / dpr}px`;
  }

  function open(button: HTMLButtonElement) {
    if (!dialog || !image || !frame) return;
    const { full, thumb, alt, size } = button.dataset;
    // The grid image shows instantly while the large one loads over it.
    frame.style.setProperty('--thumb', `url("${thumb}")`);
    photoSize = Number(size) || 0;
    image.src = full ?? '';
    image.alt = alt ?? '';
    dialog.classList.remove('closing');
    dialog.showModal();
    layout();
    // Nothing inside is focusable, so focus the dialog itself to receive Escape and Enter.
    dialog.focus();
  }

  function close() {
    if (!dialog?.open || dialog.classList.contains('closing')) return;
    if (reducedMotion.matches) {
      dialog.close();
      return;
    }
    dialog.classList.add('closing');
    // Close when the fade-out ends, or after its duration if the browser skips
    // the animation (a background tab, say), so the preview can never get stuck.
    const finish = () => {
      clearTimeout(fallback);
      dialog.removeEventListener('animationend', finish);
      dialog.classList.remove('closing');
      dialog.close();
    };
    const fallback = setTimeout(finish, 200);
    dialog.addEventListener('animationend', finish);
  }

  document.querySelectorAll<HTMLButtonElement>('.photo').forEach((button) => {
    button.addEventListener('click', () => open(button));
  });

  // A click anywhere, on the photo or around it, dismisses the preview. Right
  // clicks are left alone, so the browser's own menu (Save Image As…) still works.
  dialog?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.ctrlKey) return;
    close();
  });

  window.addEventListener('resize', () => {
    if (dialog?.open) layout();
  });

  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    close();
  });

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      close();
    }
  });
</script>
