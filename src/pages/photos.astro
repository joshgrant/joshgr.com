---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import Preview from '../components/Preview.astro';
import Base from '../layouts/Base.astro';

interface Photo {
  slug: string;
  alt: string;
  thumb: string;
  full: string;
  size: number;
}

// Written by scripts/build-photos.mjs before every `dev` and `build`.
let photos: Photo[] = [];
try {
  photos = JSON.parse(await readFile(join(process.cwd(), 'public/photos/manifest.json'), 'utf8'));
} catch {}
---
<Base title="Photos" wide>
  <h1 class="mb-8 text-[40px] leading-[1.12] font-semibold tracking-[-0.028em]">Photos</h1>
  <hr class="mb-8 h-px border-0 bg-hairline" />

  {photos.length === 0 ? (
    <p class="text-muted">No photos yet.</p>
  ) : (
    <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3">
      {photos.map((photo, i) => (
        <li class="relative aspect-square">
          <button
            type="button"
            class="photo grain"
            data-preview
            data-grain
            data-full={photo.full}
            data-thumb={photo.thumb}
            data-alt={photo.alt}
            data-width={photo.size}
            data-height={photo.size}
            aria-label={`View larger: ${photo.alt}`}
          >
            <img
              src={photo.thumb}
              alt={photo.alt}
              width="800"
              height="800"
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
        </li>
      ))}
    </ul>
  )}

  <Preview />
</Base>

<style>
  /*
    Hover scales the whole tile, photo and grain together, so the grain stays
    fixed to the photo like it's part of it. At rest there's no transform, so
    every grain pixel sits on a screen pixel.
  */
  .photo {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-wash);
    cursor: zoom-in;
    isolation: isolate;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .photo:hover {
      transform: scale(1.04);
      z-index: 1;
    }
    .photo:hover img {
      filter: saturate(1);
    }
  }

  .photo:focus-visible img {
    filter: saturate(1);
  }

  /*
    Film grain, drawn over the photo rather than baked into it, so downloads stay
    clean. The tile (scripts/build-grain.mjs) is centered on 50% gray: overlay
    leaves average brightness alone and the grain shows most in the midtones.
    It's drawn at exactly one grain pixel per screen pixel: the script below
    sets --grain-size for the display's density, including browser zoom.
  */
  .grain::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: url('/grain.webp') 0 0 / var(--grain-size, 512px) repeat;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }

  @media (resolution >= 2x) {
    :global(:root) {
      --grain-size: 256px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .photo img {
      transition: none;
    }
    .photo:hover {
      transform: none;
    }
  }
</style>

<script>
  // One grain pixel per screen pixel. Re-run when the density changes (browser
  // zoom, or moving the window to another display).
  function sizeGrain() {
    const dpr = window.devicePixelRatio || 1;
    document.documentElement.style.setProperty('--grain-size', `${512 / dpr}px`);
    window.matchMedia(`(resolution: ${dpr}dppx)`).addEventListener('change', sizeGrain, { once: true });
  }
  sizeGrain();
</script>
