---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/posts.js';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="text-muted">No posts yet.</p>
) : (
  <ul class="flex flex-col">
    {posts.map((post) => (
      <li class="border-t border-hairline last:border-b">
        <a
          href={`/writing/${post.id}/`}
          class:list={[
            'group relative flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5 text-black',
            // Room for the thumbnail plus 8px before the title.
            post.data.hero && 'pl-[47px]',
          ]}
        >
          {post.data.hero && (
            // 39px = the row's height less 8px above and below, so the row never grows.
            <Image
              src={post.data.hero}
              alt=""
              width={78}
              height={78}
              fit="cover"
              class="absolute top-1/2 left-0 size-[39px] -translate-y-1/2 rounded-[4px] object-cover"
            />
          )}
          <span class="font-medium transition-colors group-hover:text-tint">
            {post.data.title}
            {post.data.draft && <span class="ml-2 text-sm font-normal text-muted">Draft</span>}
          </span>
          <time datetime={post.data.date.toISOString()} class="text-[15px] text-muted tabular-nums">{formatDate(post.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
)}
