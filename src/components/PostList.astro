---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts.js';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="text-muted">No posts yet.</p>
) : (
  <ul class="flex flex-col">
    {posts.map((post) => (
      <li class="border-t border-hairline last:border-b">
        <a href={`/writing/${post.id}/`} class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5 text-black">
          <span class="font-medium transition-colors group-hover:text-tint">
            {post.data.title}
            {post.data.draft && <span class="ml-2 text-sm font-normal text-muted">Draft</span>}
          </span>
          <time datetime={post.data.date.toISOString()} class="text-[15px] text-muted tabular-nums">{formatDate(post.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
)}
